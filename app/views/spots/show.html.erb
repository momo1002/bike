<h2><%= @spot.title %></h2>

<div class="spot-images">
  <% @spot.images.each do |image| %>
    <%= image_tag image, class: "spot-detail-image" %>
  <% end %>
</div>

<p class="spot-description"><%= @spot.description %></p>

<p class="spot-address">住所：<%= @spot.address %></p>

<div class="spot-user">
  <% if @spot.user.icon.attached? %>
    <%= image_tag @spot.user.icon, class: "user-icon" %>
  <% else %>
    <%= image_tag "default_icon.jpg", class: "user-icon" %>
  <% end %>
  <span><%= @spot.user.username %></span>
</div>

<% if @spot.user == current_user %>
  <%= link_to "編集する", edit_spot_path(@spot), class: "edit-button" %>
<% end %>


<%= link_to "一覧に戻る", spots_path, class: "back-button" %>
<p class="created-at">作成日時：<%= @spot.created_at.strftime("%Y-%m-%d %H:%M") %></p>