<h2>スポット投稿</h2>

<%= form_with model: @spot, local: true do |f| %>

  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description, "説明" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :address, "住所" %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :images, "画像（複数OK）" %>
    <%= f.file_field :images, multiple: true, accept: "image/*" %>
  </div>

  <%= f.submit "投稿する" %>

<% end %>
